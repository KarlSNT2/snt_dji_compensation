    {
      "parameters": {
        "jsCode": "// Récupérer les données des deux sources\nconst declarationsData = $('GET Declarations Summary').first().json;\nconst promotionsData = $('GET Promotions Types').all();\n\n// Créer un index des promotions par reference_article\nconst promoByRef = {};\nfor (const promo of promotionsData) {\n  const ref = promo.json.reference_article;\n  if (ref) {\n    promoByRef[ref.toUpperCase().trim()] = promo.json.type_promotion || '';\n  }\n}\n\n// Transformer les lignes de déclarations\nconst results = [];\nconst lines = declarationsData.lines || [];\n\nfor (const d of lines) {\n  const refKey = (d.reference_article || '').toUpperCase().trim();\n  const typePromo = promoByRef[refKey] || '';\n  \n  results.push({\n    json: {\n      'NOM DU CLIENT': d.customer_company || d.customer_name || '',\n      'TYPE DE PROMO': typePromo,\n      'DATE DEBUT': d.date_debut || '',\n      'DATE FIN': d.date_fin || '',\n      'QUANTITE': d.quantite_declaree || 0,\n      'COMPENSATION HT': d.compensation_ht || 0,\n      'TOTAL': d.total_compensation_ht || (d.quantite_declaree * d.compensation_ht) || 0,\n      'REF AVOIR': d.reference_avoir || ''\n    }\n  });\n}\n\nreturn results;"
      },
